# Alles ignorieren ...
*

# ... ausser Python- und Text-Dateien (sowie dieser Datei)
!.gitignore
!*.py
!*.txt

# Docker-Compose-Konfiguration explizit tracken
!docker-compose.yml

# Debug-Logs nicht tracken (wuerden sonst als *.txt durchrutschen)
debug/

# Secrets niemals committen (explizit, unabhaengig von den Patterns oben)
.env
.env.*
